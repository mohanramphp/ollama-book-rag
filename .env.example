# Copy this file to .env and adjust as needed (optional — every value here
# has a sensible default in config.py already, so this file is only needed
# if you want to override something).

# RAG_SOURCES_DIR=./knowledge_sources
# RAG_PERSIST_DIR=./chroma_db
# RAG_MANIFEST_PATH=./knowledge_sources_manifest.json

# RAG_EMBED_MODEL=nomic-embed-text
# RAG_DEFAULT_MODEL=phi4-mini
# RAG_AVAILABLE_MODELS=phi4-mini,gemma3:4b,qwen3:8b,qwen3:14b

# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120

# RAG_TOP_K=4
# RAG_RELEVANCE_THRESHOLD=0.8
# RAG_MAX_CHUNKS_PER_SOURCE=2
# RAG_TEMPERATURE=0.0
# RAG_MAX_HISTORY_TURNS=6

# RAG_EMBED_BATCH_SIZE=40
# RAG_SEMANTIC_EMBED_BATCH_SIZE=20
# RAG_MAX_RETRIES=4
# RAG_RETRY_DELAY_SECONDS=10

# OLLAMA_HOST=http://localhost:11434
